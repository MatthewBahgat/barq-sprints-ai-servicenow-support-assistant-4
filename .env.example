SERVICENOW_INSTANCE_URL=https://your-instance.service-now.com
SERVICENOW_USERNAME=your_username
SERVICENOW_PASSWORD=your_password
SERVICENOW_KNOWLEDGE_BASE_SYS_ID=your_knowledge_base_sys_id

# Shared secret the ServiceNow Business Rule sends in the
# "X-ServiceNow-Secret" header on every webhook call (see
# businessRule/business_rule.js). Must match on both sides.
SERVICENOW_WEBHOOK_SECRET=your_webhook_secret_here


# --- Gemini / Embedding settings (S2.2) ---
GEMINI_API_KEY=your_gemini_api_key


# --- Qdrant / vector storage settings (S2.2) ---
QDRANT_URL=https://your-cluster.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION_NAME=barq_kb_chunks


# --- Retrieval settings (S2.3) ---
RETRIEVAL_SCORE_THRESHOLD=0.75
RETRIEVAL_TOP_K=5


# --- Celery / Redis settings (S3.6 / S3.3) ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1


# --- Tracing settings (S3.6) ---
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com


# --- Agent LLM settings (S3.4) ---
LITELLM_BASE_URL=https://management.sprints.ai/litellm
OPENAI_API_KEY=your_litellm_proxy_key
LLM_MODEL=gemini-3.5-flash


# --- S3.4 worker settings ---
# Application scope prefix for the AI incident fields, confirmed via
# live testing against the shared PDI (S3.1/S3.3/S3.4).
AI_FIELD_PREFIX=x_2215387_sprint_0_

AGENT_MAX_STEPS=6


# --- S3.3: HMAC signing secrets ---
# Generate with: uv run python -c "import secrets; print(secrets.token_hex(32))"
INCIDENT_SIGNING_SECRET=your_incident_signing_secret
KB_SIGNING_SECRET=your_kb_signing_secret


# --- S3.3: Redis (dedup) ---
REDIS_URL=redis://localhost:6379/0
DEDUP_KEY_PREFIX=evt:
DEDUP_TTL_SECONDS=86400


# --- S3.3: SQL state store (KB sync article hash tracking) ---
KB_STATE_DB_URL=sqlite:///./kb_state.db